# Copy to `.env` (or `.env.local`) to point the app at a real backend.
#
# All three are read by Next.js at BUILD time (inlined into the client bundle) and are the only switch between the local fixtures
# and the API — no component code changes. With none of them set, the app behaves exactly as it
# does today: every service returns its fixture and nothing is fetched.

# Turn the fixtures off. Anything other than the string "false" leaves them ON, so a checkout
# with no .env keeps working.
#
# "OFF" IS NARROWER THAN IT SOUNDS, and deliberately: it means "fetch everything that HAS a
# route", not "fetch everything". The backend this build is wired to answers part of what the
# front-end renders, so each call site declares `live: true` in `services/client.js` when a real
# endpoint exists behind it — and one that does not keeps returning its fixture with this off.
# A grep for `live: true` is the migration list.
NEXT_PUBLIC_USE_FIXTURES=false

# Prefixed onto every path in src/services/endpoints.js. Leave empty to call the same origin the
# app is served from (which is what bc.game itself does — its paths are all /api/...).
#
# The local platform's gateway is the single public entry point for all four services:
#   NEXT_PUBLIC_API_BASE=http://127.0.0.1:4000
# Its CORS_ORIGIN must allow http://localhost:5190, the Next dev port (it used to be Vite's 5173).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:4000

# How long a FIXTURE read pretends to take, in milliseconds. Ignored for anything marked `live`
# once NEXT_PUBLIC_USE_FIXTURES is off — a real fetch takes as long as it takes. Unset means 400, which
# is what makes every page's loading state (spinner, skeleton, delayed box) actually render on a
# cold load.
#
#   NEXT_PUBLIC_FIXTURE_DELAY=0     fixtures answer synchronously — no Promise and no pending frame,
#                            which is how this build behaved before the loaders were built.
#                            Set this when measuring a page against the reference capture.
NEXT_PUBLIC_FIXTURE_DELAY=400

# The owner panel's branding (title, description, logo NAME from public/brand/). Unset keeps the
# layout's own title and the bundled logo.
# NEXT_PUBLIC_SITE_TITLE=
# NEXT_PUBLIC_SITE_DESCRIPTION=
# NEXT_PUBLIC_SITE_LOGO=

# Where the player site's `/agent` page sends agents: the site admin's agent portal sign-in.
# Shown only when the owner's business model has agents (b2b or hybrid). Unset means the local
# admin, http://localhost:3080/agent.
# NEXT_PUBLIC_AGENT_PORTAL_URL=http://localhost:3080/agent

# The old VITE_* names (VITE_API_BASE, VITE_USE_FIXTURES, VITE_FIXTURE_DELAY, VITE_SITE_*) are
# still honoured as a fallback by next.config.mjs, so an older .env.local keeps working; a
# NEXT_PUBLIC_* value wins when both are set. Shell values win over every env file.
